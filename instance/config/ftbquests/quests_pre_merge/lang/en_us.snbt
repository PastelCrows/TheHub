	quest.000000000000208B.title: "Golden Amber"
	quest.000000000000208C.title: "Icestone"
	quest.000000000000208D.quest_subtitle: "The Aether's best metal, and it floats"
	quest.000000000000208D.title: "Enchanted Gravitite"
	quest.000000000000208E.title: "Gravitite Armour"
	quest.000000000000208F.title: "Flaming Sword"
	quest.0000000000002090.title: "Cloud Staff"
	quest.0000000000002091.quest_subtitle: "Your key downward"
	quest.0000000000002091.title: "The Catalyst"
	quest.0000000000002092.title: "The Undergarden"
