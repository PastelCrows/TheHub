	quest.00000000000020A7.title: "Bone Reptile Armour"
	quest.00000000000020A8.quest_subtitle: "Born in Chaos"
	quest.00000000000020A8.title: "Dark Metal"
	quest.00000000000020A9.title: "Soulbane"
	quest.00000000000020AA.quest_desc: ["A Gate Pearl drops a wave arena at your feet. Clear it and it pays out properly. If you cannot clear one yet, you are not ready for the End."]
	quest.00000000000020AA.quest_subtitle: "Prove the gear works"
	quest.00000000000020AA.title: "Open a Gateway"
	quest.00000000000020AB.quest_desc: ["One thing remains, and getting into it is no longer as simple as twelve ender pearls."]
	quest.00000000000020AB.quest_subtitle: "The dark is just scenery now"
	quest.00000000000020AB.title: "Nothing Left to Fear"
	quest.00000000000020AD.quest_desc: [
		"Vanilla sells you the End for twelve blaze powders and some pearls. End Remastered takes that away. Each eye now comes from a specific place or a specific kill, scattered across every dimension you have been to."
		""
		"This is the pack's final exam. It sends you back through everything."
	]
	quest.00000000000020AD.quest_subtitle: "End Remastered: the End is earned, not bought"
