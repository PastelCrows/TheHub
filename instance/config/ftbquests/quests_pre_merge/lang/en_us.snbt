	chapter_group.0000000000002263.title: "Act III — The Far Places"
	quest.0000000000002005.quest_desc: [
		"This pack has a lot in it, so this book is the thread through all of it. Chapters unlock as you finish the one before, so you can always just do what is lit up."
		""
		"One tip worth more than any other: hold W while looking at any Create block to open Ponder. It animates exactly how the thing works. It is better than any wiki."
	]
	quest.0000000000002005.quest_subtitle: "Day one, nothing in your pockets"
	quest.0000000000002005.title: "Landfall"
	quest.0000000000002006.quest_subtitle: "The usual opening"
	quest.0000000000002006.title: "Wood and Stone"
	quest.0000000000002007.quest_subtitle: "Stone will do for now"
	quest.0000000000002007.title: "A Real Pickaxe"
	quest.0000000000002008.quest_desc: ["Chop ingredients on a cutting board for more yield than crafting by hand. Everything in Farmer's Delight builds on this and the cooking pot."]
	quest.0000000000002008.quest_subtitle: "Farmer's Delight starts here"
	quest.0000000000002008.title: "Cutting Board"
	quest.0000000000002009.quest_subtitle: "Stop eating raw potatoes"
	quest.0000000000002009.title: "Something Hot"
	quest.000000000000200A.quest_desc: ["Nights get genuinely dangerous later in this pack. Born in Chaos sees to that."]
	quest.000000000000200A.quest_subtitle: "Skip the dangerous part of the day"
	quest.000000000000200A.title: "Somewhere to Sleep"
	quest.000000000000200B.quest_subtitle: "Light is survival"
	quest.000000000000200B.title: "Torches by the Hundred"
	quest.000000000000200C.quest_subtitle: "Quark's backpack"
	quest.000000000000200C.title: "Something to Carry It In"
	quest.000000000000200D.quest_desc: ["Quark adds hundreds of small things like this. You will keep finding them for weeks."]
	quest.000000000000200D.quest_subtitle: "Count what you are standing on"
	quest.000000000000200D.title: "The Abacus"
	quest.000000000000200E.title: "Know Where You Are"
	quest.000000000000200F.quest_desc: ["Iron opens up the two directions this pack goes first: a home worth living in, and gear worth fighting in. Both chapters unlock from here."]
	quest.000000000000200F.quest_subtitle: "The real start"
	quest.000000000000200F.title: "Iron at Last"
	quest.0000000000002011.quest_desc: [
		"You are going to be away a lot in this pack. Make the place you return to good."
		""
		"Handcrafted, Chipped, FramedBlocks, Supplementaries, Amendments and all five Macaw's packs are installed. Open JEI and search a material name to see what is possible."
	]
	quest.0000000000002011.quest_subtitle: "Build somewhere you want to come back to"
	quest.0000000000002011.title: "Hearth \\& Home"
	quest.0000000000002012.quest_subtitle: "Furniture that is actually furniture"
	quest.0000000000002012.title: "A Table and a Chair"
	quest.0000000000002013.title: "A Kitchen Counter"
	quest.0000000000002014.quest_subtitle: "Cook six things at once"
	quest.0000000000002014.title: "A Stove"
	quest.0000000000002015.quest_desc: ["Soups and stews from the cooking pot are the best food in the pack and they stack."]
	quest.0000000000002015.quest_subtitle: "The heart of Farmer's Delight"
	quest.0000000000002015.title: "The Cooking Pot"
	quest.0000000000002016.quest_subtitle: "Cook in the field"
	quest.0000000000002016.title: "Skillet"
	quest.0000000000002017.title: "Compost and Crops"
	quest.0000000000002018.quest_desc: ["These barrels and chests take upgrades: stack size, auto-pickup, filtering, even a crafting grid. One upgraded barrel replaces a wall of chests."]
	quest.0000000000002018.quest_subtitle: "Sophisticated Storage"
	quest.0000000000002018.title: "Storage, Properly"
	quest.0000000000002019.quest_subtitle: "Stack upgrades are the good ones"
	quest.0000000000002019.title: "Upgrade It"
	quest.000000000000201A.title: "Crates for the Overflow"
	quest.000000000000201B.title: "A Safe for the Good Stuff"
	quest.000000000000201C.quest_subtitle: "Supplementaries odds and ends"
	quest.000000000000201C.title: "Sacks and Soap"
	quest.000000000000201D.quest_desc: ["With a base and a kitchen behind you, it is time to make it do some work for you."]
	quest.000000000000201D.quest_subtitle: "Somewhere worth defending"
	quest.000000000000201D.title: "Home"
	quest.000000000000201F.quest_desc: ["Apotheosis rebuilds enchanting, loot and gear. Weapons and armour now roll affixes and have sockets for gems, so a sword you find in a dungeon can beat anything you craft. Enchanting needs a table surrounded by the right shelves, not just bookshelves."]
	quest.000000000000201F.quest_subtitle: "Apotheosis changes what gear means"
	quest.000000000000201F.title: "Iron \\& Enchantment"
	quest.0000000000002020.title: "Diamonds"
	quest.0000000000002021.title: "The Enchanting Table"
	quest.0000000000002022.quest_desc: ["Each shelf type pushes enchanting in a different direction: eterna, quanta and arcana. The table's tooltip shows what your arrangement is doing."]
	quest.0000000000002022.quest_subtitle: "Not all bookshelves are equal"
	quest.0000000000002022.title: "Shelves That Matter"
	quest.0000000000002023.quest_subtitle: "You need what is in there"
	quest.0000000000002023.title: "Into the Nether"
	quest.0000000000002024.title: "Blaze Rods"
	quest.0000000000002025.quest_subtitle: "Quanta, at a cost"
	quest.0000000000002025.title: "Hellshelf"
	quest.0000000000002026.quest_subtitle: "Add a socket to anything"
	quest.0000000000002026.title: "Sigil of Socketing"
	quest.0000000000002027.quest_subtitle: "Break gear down into gems and materials"
	quest.0000000000002027.title: "Salvaging Table"
	quest.0000000000002028.quest_subtitle: "Simply Swords"
	quest.0000000000002028.title: "A Better Blade"
	quest.0000000000002029.quest_subtitle: "Reach beats damage more often than you think"
	quest.0000000000002029.title: "Or a Glaive"
	quest.000000000000202A.quest_desc: ["Gear sorted. Now go and find out how big this world actually is, and start learning what the arcane side of it can do."]
	quest.000000000000202A.quest_subtitle: "Ready to leave the valley"
	quest.000000000000202A.title: "Armed and Enchanted"
	quest.000000000000202C.quest_desc: ["Terralith and Tectonic rebuilt this world, and 27 structure mods filled it. YUNG's overhauls replaced every vanilla structure. There is a lot out there, and two compasses so you never have to wander aimlessly looking for it."]
	quest.000000000000202C.quest_subtitle: "The overworld is far bigger than it looks"
	quest.000000000000202C.title: "The Wayfarer"
	quest.000000000000202D.quest_subtitle: "Find any structure on demand"
	quest.000000000000202D.title: "Explorer's Compass"
	quest.000000000000202E.quest_subtitle: "Find any biome on demand"
	quest.000000000000202E.title: "Nature's Compass"
	quest.000000000000202F.quest_subtitle: "Travel without the walking"
	quest.000000000000202F.title: "A Waystone"
	quest.0000000000002030.quest_subtitle: "Reusable return trip"
	quest.0000000000002030.title: "Warp Stone"
	quest.0000000000002031.title: "Warp Scrolls"
	quest.0000000000002032.quest_desc: ["Artifacts drop from the structures you are about to raid. The umbrella slows your fall and blocks arrows. There are plenty more."]
	quest.0000000000002032.quest_subtitle: "Artifacts are dungeon loot worth hunting"
	quest.0000000000002032.title: "An Umbrella"
	quest.0000000000002033.title: "Night Vision Goggles"
	quest.0000000000002034.title: "Cloud in a Bottle"
	quest.0000000000002035.quest_subtitle: "Push an enchantment past its cap"
	quest.0000000000002035.title: "Ancient Tome"
	quest.0000000000002036.quest_subtitle: "Proof you went somewhere"
	quest.0000000000002036.title: "A Globe for the Wall"
	quest.0000000000002037.quest_desc: ["There is a second world layered under this one, reachable from a pool of water and a diamond. It has its own full progression, and it is the best content in the pack."]
	quest.0000000000002037.quest_subtitle: "You have seen this world"
	quest.0000000000002037.title: "Well Travelled"
	quest.0000000000002039.quest_desc: [
		"This is the machine half of the pack. Create is about rotation: generate it, move it, and spend it on something useful."
		""
		"Hold W over any Create block for Ponder. Seriously. Do it for every block in this chapter and you will never need to look anything up."
	]
	quest.0000000000002039.quest_subtitle: "Create, the light-tech spine"
	quest.0000000000002039.title: "Wheels \\& Water"
	quest.000000000000203A.quest_subtitle: "Everything starts here"
	quest.000000000000203A.title: "Andesite Alloy"
	quest.000000000000203B.quest_subtitle: "Move rotation around"
	quest.000000000000203B.title: "Cogwheels"
	quest.000000000000203C.quest_subtitle: "Free, quiet, early power"
	quest.000000000000203C.title: "Water Wheel"
	quest.000000000000203D.quest_subtitle: "Grinding with no infrastructure"
	quest.000000000000203D.title: "Millstone"
	quest.000000000000203E.quest_subtitle: "Plates and compacting"
	quest.000000000000203E.title: "Mechanical Press"
	quest.000000000000203F.quest_desc: ["A fan blowing through water washes gravel and ore. Through lava it smelts. Through soul fire it haunts. One block, four processing chains."]
	quest.000000000000203F.quest_subtitle: "Wash, smelt and haunt"
	quest.000000000000203F.title: "Encased Fan"
	quest.0000000000002040.title: "Mechanical Mixer"
	quest.0000000000002041.quest_subtitle: "The second tier metal"
	quest.0000000000002041.title: "Brass"
	quest.0000000000002042.quest_subtitle: "Heat for the mixer"
	quest.0000000000002042.title: "Blaze Burner"
	quest.0000000000002043.quest_subtitle: "The best ore processing at this tier"
	quest.0000000000002043.title: "Crushing Wheels"
	quest.0000000000002044.quest_subtitle: "When water wheels stop being enough"
	quest.0000000000002044.title: "Steam Engine"
	quest.0000000000002045.quest_subtitle: "Automated crafting"
	quest.0000000000002045.title: "Mechanical Crafters"
	quest.0000000000002046.quest_desc: ["You can make things without touching them now. Later you will wire this to electricity and point it at the arcane side of the pack."]
	quest.0000000000002046.quest_subtitle: "Rotation, mastered"
	quest.0000000000002046.title: "A Working Factory"
	quest.0000000000002048.quest_desc: [
		"Four magic systems are installed and this book sequences them so they do not all land at once. Ars Nouveau is first because it teaches the idea: spells are made of glyphs you combine yourself, not picked off a list."
		""
		"Craft the Worn Notebook before anything else. It is the actual tutorial."
	]
	quest.0000000000002048.quest_subtitle: "Ars Nouveau: build your own spells"
	quest.0000000000002048.title: "First Glyphs"
	quest.0000000000002049.quest_subtitle: "The currency of everything here"
	quest.0000000000002049.title: "Source Gems"
	quest.000000000000204A.quest_desc: ["A spell is a form (Projectile, Touch, Self) then effects then modifiers. Projectile + Break is a mining laser. Touch + Harvest is a sickle."]
	quest.000000000000204A.quest_subtitle: "Form, then effect, then modifier"
	quest.000000000000204A.title: "Novice Spell Book"
	quest.000000000000204B.quest_subtitle: "Where glyphs are written"
	quest.000000000000204B.title: "Scribes Table"
	quest.000000000000204C.quest_subtitle: "Make your own source gems"
	quest.000000000000204C.title: "Imbuement Chamber"
	quest.000000000000204D.quest_subtitle: "Store the magic"
	quest.000000000000204D.title: "Source Jar"
	quest.000000000000204E.quest_subtitle: "Move source without pipes"
	quest.000000000000204E.title: "Relay Network"
	quest.000000000000204F.title: "Arcane Pedestals"
	quest.0000000000002050.quest_subtitle: "The crafting station for everything else"
	quest.0000000000002050.title: "Enchanting Apparatus"
	quest.0000000000002051.quest_subtitle: "Grow your own cloth"
	quest.0000000000002051.title: "Magebloom"
	quest.0000000000002052.quest_subtitle: "Rituals change the world around you"
	quest.0000000000002052.title: "Ritual Brazier"
	quest.0000000000002053.quest_subtitle: "A bigger book, more spell slots"
	quest.0000000000002053.title: "Apprentice"
	quest.0000000000002054.quest_desc: ["Two paths open from here: a second, very different magic tradition, and the twilight world you were told about."]
	quest.0000000000002054.quest_subtitle: "You can write magic now"
	quest.0000000000002054.title: "Spellwright"
	quest.0000000000002056.quest_desc: [
		"Dig a 2x2 pool, fill it with water, ring it with flowers and mushrooms, and throw in a diamond."
		""
		"The Twilight Forest is gated internally: each boss you kill lifts the curse on the next region. Kill them in order or the forest itself will stop you. This chapter is that order."
	]
	quest.0000000000002056.quest_subtitle: "A whole second game, with its own ladder"
	quest.0000000000002056.title: "Into the Twilight"
	quest.0000000000002057.quest_subtitle: "See through the labyrinth"
	quest.0000000000002057.title: "Maze Map Focus"
	quest.0000000000002058.quest_subtitle: "First boss, first lock lifted"
	quest.0000000000002058.title: "The Naga"
	quest.0000000000002059.title: "Ironwood"
	quest.000000000000205A.quest_subtitle: "Second boss"
	quest.000000000000205A.title: "The Twilight Lich"
	quest.000000000000205B.quest_subtitle: "The labyrinth has a kitchen"
	quest.000000000000205B.title: "Meef Stroganoff"
	quest.000000000000205C.quest_subtitle: "Under the labyrinth"
	quest.000000000000205C.title: "The Minoshroom"
	quest.000000000000205D.quest_subtitle: "Three heads, all of them a problem"
	quest.000000000000205D.title: "The Hydra"
	quest.000000000000205E.quest_subtitle: "The stronghold"
	quest.000000000000205E.title: "The Knight Phantom"
	quest.000000000000205F.title: "Fiery Ingots"
	quest.0000000000002060.quest_subtitle: "The glacier"
	quest.0000000000002060.title: "The Alpha Yeti"
	quest.0000000000002061.quest_subtitle: "The aurora palace"
	quest.0000000000002061.title: "The Snow Queen"
	quest.0000000000002062.quest_subtitle: "Highlands reward"
	quest.0000000000002062.title: "Carminite"
	quest.0000000000002063.quest_subtitle: "Burn back the thorns"
	quest.0000000000002063.title: "Lamp of Cinders"
	quest.0000000000002064.quest_desc: ["You have cleared a full dimension's worth of bosses. There are two more worlds waiting, and they are stranger than this one."]
	quest.0000000000002064.quest_subtitle: "That forest is yours"
	quest.0000000000002064.title: "Twilight Conqueror"
	quest.0000000000002066.quest_desc: ["Where Ars Nouveau makes you build spells, Iron's Spells gives you schools to specialise in: fire, ice, lightning, evocation, holy, blood, ender, nature. Your spell book holds a loadout and your gear rolls spell power for a school."]
	quest.0000000000002066.quest_subtitle: "Iron's Spells: pick a school and commit"
	quest.0000000000002066.title: "Schools of Magic"
	quest.0000000000002067.quest_subtitle: "Your first real loadout"
	quest.0000000000002067.title: "Iron Spell Book"
	quest.0000000000002068.quest_subtitle: "Write scrolls into your book"
	quest.0000000000002068.title: "Inscription Table"
	quest.0000000000002069.title: "Blank Runes"
	quest.000000000000206A.quest_subtitle: "Upgrade gear with orbs"
	quest.000000000000206A.title: "Arcane Anvil"
	quest.000000000000206B.quest_subtitle: "More casting before you run dry"
	quest.000000000000206B.title: "Mana Upgrade Orb"
	quest.000000000000206C.title: "Mana Ring"
	quest.000000000000206D.title: "The Fire School"
	quest.000000000000206E.title: "The Ice School"
	quest.000000000000206F.title: "Evocation"
	quest.0000000000002070.quest_subtitle: "More slots, more power"
	quest.0000000000002070.title: "Diamond Spell Book"
	quest.0000000000002071.quest_subtitle: "The one you should be careful with"
	quest.0000000000002071.title: "The Necronomicon"
	quest.0000000000002072.quest_desc: ["Now put machinery and magic in the same room. It turns out they get on well."]
	quest.0000000000002072.quest_subtitle: "Two traditions, both yours"
	quest.0000000000002072.title: "Archmage's Apprentice"
	quest.0000000000002074.quest_desc: ["This is the chapter that makes the pack one thing instead of several. Create generates electricity, electricity runs an enchanting line, and that line produces Apotheosis affixes on demand. Occultism then hands you storage and labour that no machine can match."]
	quest.0000000000002074.quest_subtitle: "Where the machines meet the magic"
	quest.0000000000002074.title: "The Arcane Engine"
	quest.0000000000002075.quest_subtitle: "Rotation into electricity"
	quest.0000000000002075.title: "Alternator"
	quest.0000000000002076.quest_subtitle: "And back again"
	quest.0000000000002076.title: "Electric Motor"
	quest.0000000000002077.quest_subtitle: "Store it"
	quest.0000000000002077.title: "Capacitor"
	quest.0000000000002078.quest_subtitle: "Wire and rods without a press setup"
	quest.0000000000002078.title: "Rolling Mill"
	quest.0000000000002079.quest_subtitle: "Wireless charging, and a weapon"
	quest.0000000000002079.title: "Tesla Coil"
	quest.000000000000207A.quest_subtitle: "Automated enchanting"
	quest.000000000000207A.title: "Blaze Enchanter"
	quest.000000000000207B.quest_desc: ["Create Enchantment Industry speaks Apotheosis. This is the bridge between the two halves of the pack and it is the single best thing in it."]
	quest.000000000000207B.quest_subtitle: "Liquid affixes"
	quest.000000000000207B.title: "Apotheotic Essence"
	quest.000000000000207C.quest_subtitle: "Roll affixes on purpose, not by luck"
	quest.000000000000207C.title: "Affix Augmentor"
	quest.000000000000207D.quest_desc: ["Occultism summons spirits to do work: mine for you, chop trees, haul items, and hold a near-infinite warehouse inside one block."]
	quest.000000000000207D.quest_subtitle: "Draw a summoning circle"
	quest.000000000000207D.title: "Occultism: A Brush and Chalk"
	quest.000000000000207E.quest_subtitle: "Only visible with the right eyes"
	quest.000000000000207E.title: "Otherworld Trees"
	quest.000000000000207F.title: "Spirit Attuned Crystal"
	quest.0000000000002080.quest_subtitle: "Bind a spirit"
	quest.0000000000002080.title: "Magic Lamp"
	quest.0000000000002081.quest_subtitle: "The metal of the other side"
