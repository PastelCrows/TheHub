	quest.0000000000002082.quest_subtitle: "The best storage in the pack"
	quest.0000000000002082.title: "Storage Controller"
	quest.0000000000002083.quest_subtitle: "Reach your warehouse from anywhere"
	quest.0000000000002083.title: "Stable Wormhole"
	quest.0000000000002084.quest_desc: ["Everything from here on is dangerous. Good thing you are well equipped."]
	quest.0000000000002084.quest_subtitle: "Machines, spirits, one base"
	quest.0000000000002084.title: "Industrialist of the Occult"
	quest.0000000000002086.quest_desc: ["Two more dimensions, opposite in every way. The Aether is a bright floating world reached by pouring water into a glowstone frame. The Undergarden is a dark cavern world reached by throwing a Catalyst at an obsidian frame."]
	quest.0000000000002086.quest_subtitle: "One world above, one below"
	quest.0000000000002086.title: "Other Skies"
	quest.0000000000002087.quest_subtitle: "Water will not survive the trip otherwise"
	quest.0000000000002087.title: "Skyroot Bucket"
	quest.0000000000002088.title: "The Aether"
