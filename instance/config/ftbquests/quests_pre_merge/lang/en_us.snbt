	quest.0000000000002095.title: "Utherium"
	quest.0000000000002096.quest_subtitle: "Deepest and best"
	quest.0000000000002096.title: "Forgotten Metal"
	quest.0000000000002097.title: "Regalium"
	quest.0000000000002098.quest_desc: ["Only the dark half of this pack is left, and then the End."]
	quest.0000000000002098.quest_subtitle: "Four dimensions cleared"
	quest.0000000000002098.title: "Between Worlds"
	quest.000000000000209A.quest_desc: [
		"The last tier of this pack is its grimmest. Malum is magic by sacrifice rather than study. L_Ender's Cataclysm puts real multi-phase bosses in real dungeons. Born in Chaos makes the dark genuinely hostile."
		""
		"Gateways to Eternity is installed too: a Gate Pearl summons a wave arena wherever you stand. It is the cleanest way to test whether your gear is actually ready."
	]
	quest.000000000000209A.quest_subtitle: "Malum, Cataclysm, and nights that bite back"
	quest.000000000000209A.title: "The Long Dark"
	quest.000000000000209B.quest_subtitle: "Malum's guide"
